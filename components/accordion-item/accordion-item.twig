{#-
/**
 * @file
 * Accordion Item component.
 *
 * Available properties:
 * - accordion_item_title (string)
 * - accordion_item_icon (render array|string|null)
 * - accordion_item_description (string)
 * - accordion_item_name (string|null): details name attribute (exclusive group)
 * - accordion_item_content (string) — pre-rendered body
 * - accordion_item_open (boolean) (default: false)
 * - accordion_item_uc (array) (default: [])
 * - accordion_item_att (Drupal\Core\Template\Attribute)
 */
-#}

{% set accordion_item_att = accordion_item_att ?: create_attribute() %}
{%
  set accordion_item_classes = [
    'accordion-item',
  ]|merge(accordion_item_uc ?: [])
%}

{%- if accordion_item_open -%}
  {% set accordion_item_att = accordion_item_att.setAttribute('open', true) %}
{%- endif -%}

<details{{ accordion_item_att.addClass(accordion_item_classes) }}{%- if accordion_item_name -%} name="{{ accordion_item_name }}"{%- endif -%}>
  <summary>
    {%- if accordion_item_icon.0 -%}
      <span class="accordion-item__icon">
        {{- accordion_item_icon -}}
      </span>
    {%- endif -%}

    <span class="accordion-item__body">
      <h3 class="accordion-item__title">
        {{- accordion_item_title -}}
      </h3>

      {%- if accordion_item_description.0 -%}
        <span class="accordion-item__description">
          {{- accordion_item_description -}}
        </span>
      {%- endif -%}
    </span>

    {% include 'mud_egov:plus-minus' -%}
  </summary>

  {%- if accordion_item_content -%}
    <div class="accordion-content">
      {{- accordion_item_content -}}
    </div>
  {%- endif -%}
</details>
