{#-
/**
 * @file
 * Accordion component: wrapper around accordion-item (<details>) elements.
 *
 * Available properties:
 * - accordion_id (int|string) (default: 0): id attribute of the wrapper.
 * - accordion_flush (boolean) (default: false): draws an outer border (is-bordered).
 * - accordion_size ('' | small | large) (default: ''): adds an is-<size> class.
 * - accordion_appearance (single|multiple) (default: multiple)
 * - accordion_mode (boolean) (default: false): stay open.
 * - accordion_open_item_id (int) (default: 0)
 * - accordion_icon_position (none|left|right) (default: left)
 * - accordion_content (string): pre-rendered accordion-item elements.
 * - accordion_uc (array) (default: [])
 * - accordion_att (Drupal\Core\Template\Attribute)
 *
 * @see accordion.md
 */
-#}

{#- Create attributes -#}
{% set accordion_att = accordion_att ?: create_attribute() %}

{#- Component classes -#}
{%
  set accordion_classes = [
    'accordion',
    accordion_flush ? 'is-bordered',
    accordion_size ? 'is-' ~ accordion_size,
  ]|merge(accordion_uc ?: [])
%}

{#- ID -#}
{%- if accordion_id -%}
  {% set accordion_att = accordion_att.setAttribute('id', accordion_id) %}
{%- endif -%}

{#- Render component -#}
{%- if accordion_content -%}
  <div{{ accordion_att.addClass(accordion_classes) }}>
    {{- accordion_content -}}
  </div>
{%- endif -%}
