{#-
/**
 * @file
 * Card Document component.
 *
 * Props:
 * - card_doc_title (string|null)
 * - card_doc_url (string|null)        — whole-card link when no items
 * - card_doc_meta (string|null)       — gray subtitle (single-item mode)
 * - card_doc_type (string)            — "link" | "document" (icon choice)
 * - card_doc_items (array)            — [{ url, title, meta?, type }]
 * - card_doc_uc (array)               — utility classes
 * - card_doc_att (Attribute)
 */
-#}

{% set card_doc_type = card_doc_type|default('link') %}
{% set card_doc_items = card_doc_items|default([]) %}
{% set card_doc_att = card_doc_att ?: create_attribute() %}

{% set is_list = card_doc_items|length > 1 %}
{% set is_clickable = not is_list and card_doc_url %}

{% set card_doc_classes = [
  'c--card-document',
  'c--card-document__' ~ card_doc_type,
  is_clickable ? 'c--card-document__is-link',
  is_list ? 'c--card-document__is-list',
]|merge(card_doc_uc ?: []) %}

{% set icon_arrow %}
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M7 17L17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{% endset %}

{% set icon_document %}
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    <path d="M14 3v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>
{% endset %}

{% set card_icon = card_doc_type == 'document' ? icon_document : icon_arrow %}

<div{{ card_doc_att.addClass(card_doc_classes) }}>

  <div class="card-document-icon" aria-hidden="true">
    {{- card_icon -}}
  </div>

  {% if card_doc_title %}
    <p class="card-document-title">
      {%- if is_clickable -%}
        <a href="{{ card_doc_url }}" class="card-document-link">
          {{- card_doc_title -}}
        </a>
      {%- else -%}
        {{- card_doc_title -}}
      {%- endif -%}
    </p>
  {% endif %}

  {% if not is_list and card_doc_meta %}
    <p class="card-document-meta">
      {{- card_doc_meta -}}
    </p>
  {% endif %}

  {% if is_list %}
    <ul class="card-document-items">
      {% for item in card_doc_items %}
        <li class="card-document-item card-document-item__{{ item.type|default('link') }}">
          <a href="{{ item.url }}" class="card-document-item-link">
            <span class="card-document-item-title">
              {{- item.title -}}
            </span>
            {% if item.meta %}
              <span class="card-document-item-meta">
                {{- item.meta -}}
              </span>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

</div>
