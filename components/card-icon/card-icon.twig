{#-
/**
 * @file
 * Card Icon component.
 *
 * Props:
 * - card_title (string|null)
 * - card_description (string|null)
 *
 * Slots:
 * - card_icon — rendered icon field
 */
-#}

{% set card_att = card_att ?: create_attribute() %}
{% set card_classes = ['c--card-icon']|merge(card_uc ?: []) %}

<div{{ card_att.addClass(card_classes) }}>
  <div class="card-icon-header">
    {%- if card_icon -%}
      <div class="card-icon-icon">
        {{- card_icon -}}
      </div>
    {%- endif -%}

    {%- if card_title -%}
      <p class="card-icon-title">
        {{- card_title -}}
      </p>
    {%- endif -%}
  </div>

  {%- if card_description -%}
    <div class="card-icon-description">
      {{- card_description -}}
    </div>
  {%- endif -%}
</div>
