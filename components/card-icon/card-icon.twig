{#-
/**
 * @file
 * Card Icon component.
 *
 * Props:
 * - card_icon_title (string|null)
 * - card_icon_description (string|null)
 *
 * Slots:
 * - card_icon — rendered icon field
 */
-#}

{% set card_icon_att = card_icon_att ?: create_attribute() %}
{% set card_icon_classes = ['c--card-icon']|merge(card_icon_uc ?: []) %}

<div{{ card_icon_att.addClass(card_icon_classes) }}>
  <div class="card-icon-header">
    {%- if card_icon -%}
      <div class="card-icon-icon">
        {{- card_icon -}}
      </div>
    {%- endif -%}

    {%- if card_icon_title -%}
      <p class="card-icon-title">
        {{- card_icon_title -}}
      </p>
    {%- endif -%}
  </div>

  {%- if card_icon_description -%}
    <div class="card-icon-description">
      {{- card_icon_description -}}
    </div>
  {%- endif -%}
</div>
