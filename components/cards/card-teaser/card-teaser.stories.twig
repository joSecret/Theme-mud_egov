{% stories CardTeaser with {
  title: 'Components/Cards/Card Teaser',
  argTypes: {
    card_teaser_title: {
      control: 'text'
    },
    card_teaser_description: {
      control: 'text'
    },
    card_teaser_bundle: {
      control: 'text'
    },
    card_teaser_date: {
      control: 'text'
    },
    card_teaser_link: {
      control: 'text'
    },
    has_video: {
      control: 'boolean'
    }
  }
} %}

  {% story default with {
    name: 'Default',
    args: {
      card_teaser_title: 'Sample Card Title',
      card_teaser_description: 'This is a sample description for the card component. It demonstrates how the card displays content with an image and text.',
      card_teaser_img: '<img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400&h=200&fit=crop" alt="Placeholder image" />',
      card_teaser_bundle: 'Article',
      card_teaser_date: '09 Nov 2024',
      card_teaser_link: '#',
      has_video: false
    }
  } %}
    <div class="w-docs" style="--w-docs_m-w: 320px;">
      {% include 'mud_egov:card-teaser' with {
        card_teaser_title: card_teaser_title,
        card_teaser_description: card_teaser_description,
        card_teaser_img: card_teaser_img,
        card_teaser_bundle: card_teaser_bundle,
        card_teaser_date: card_teaser_date,
        card_teaser_link: card_teaser_link,
        has_video: has_video
      } %}
    </div>
  {% endstory %}

  {% story withVideo with {
    name: 'With Video',
    args: {
      card_teaser_title: 'Video Card Title',
      card_teaser_description: 'This card contains a video instead of an image, with a play icon overlay.',
      card_teaser_img: '<img src="https://images.unsplash.com/photo-1492619375914-88005aa9e8fb?w=400&h=200&fit=crop" alt="Video placeholder" />',
      card_teaser_bundle: 'Video',
      card_teaser_date: '15 Jan 2024',
      card_teaser_link: '#',
      has_video: true
    }
  } %}
    <div class="w-docs" style="--w-docs_m-w: 320px;">
      {% include 'mud_egov:card-teaser' with {
        card_teaser_title: card_teaser_title,
        card_teaser_description: card_teaser_description,
        card_teaser_img: card_teaser_img,
        card_teaser_bundle: card_teaser_bundle,
        card_teaser_date: card_teaser_date,
        card_teaser_link: card_teaser_link,
        has_video: has_video
      } %}
    </div>
  {% endstory %}
{% endstories %}
