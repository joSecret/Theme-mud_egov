{#-
/**
  * @file
  * Card teaser component (standalone).
  *
  * Props:
  * - card_teaser_title_heading (string) - HTML tag for the title, e.g., h2, h3, etc.
  * - card_teaser_title (string)
  * - card_teaser_description (string)
  * - card_teaser_img (string)
  * - card_teaser_imgAlt (string)
  * - card_teaser_bundle (string)
  * - card_teaser_date (string)
  * - card_teaser_link (string)
  * - card_teaser_link_text (string)
  * - card_teaser_link_icon (string)
  * - has_video (bool)
  * - card_teaser_uc (array) - Additional classes for the card teaser.
  *
  * Slots (blocks):
  * - slot_card_image_top
  * - slot_details
  * - slot_title
  * - slot_description
  * - slot_link
  */
-#}

{#- Set default value -#}
{% set card_teaser_title_heading = card_teaser_title_heading|default('h3') %}
{% set card_teaser_title = card_teaser_title|default(null) %}
{% set card_teaser_description = card_teaser_description|default(null) %}
{% set card_teaser_img = card_teaser_img|default(null) %}
{% set card_teaser_bundle = card_teaser_bundle|default(null) %}
{% set card_teaser_date = card_teaser_date|default(null) %}
{% set card_teaser_link = card_teaser_link|default(null) %}
{% set card_teaser_link_text = card_teaser_link_text|default('Read more') %}
{% set card_teaser_link_icon = card_teaser_link_icon|default('<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 2.875L10.125 5.99999L7 9.125M9.75 5.99999H1.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path></svg>') %}
{% set card_teaser_video_link = card_teaser_video_link|default(null) %}
{% set has_video = has_video|default(false) %}

{#- Create attributes -#}
{% set card_teaser_att = card_teaser_att ?: create_attribute() %}
{% set card_teaser_ew_img_att = card_teaser_ew_img_att ?: create_attribute() %}

{#- Component classes -#}
{% set card_teaser_classes = [
  'c--cardTeaser'
]|merge(card_teaser_uc ?: []) %}

{% set card_teaser_ew_img_classes = [
  'cardTeaser-ewImg',
] %}

{#- Change attributes -#}
{% set ew_img_tag = has_video ? 'a' : 'div' %}
{%- if has_video -%}
  {% set card_teaser_ew_img_att = card_teaser_ew_img_att.setAttribute('href', card_teaser_video_link) %}
{%- endif -%}

{#- Render component -#}
<article {{ card_teaser_att.addClass(card_teaser_classes) }}>
  {% block slot_card_image_top -%}
    <div class="cardTeaser-imgWrapper">
      <{{ ew_img_tag }} {{ card_teaser_ew_img_att.addClass(card_teaser_ew_img_classes) }}>
        {{- card_teaser_img -}}

        {%- if has_video -%}
          <span class="cardTeaser-videoIcon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle opacity="0.8" cx="24" cy="24" r="24" fill="currentColor"/>
              <path d="M34.3772 23.8139L16.9281 13.6029V34.0248L34.3772 23.8139Z" fill="white"/>
            </svg>
          </span>
        {%- endif -%}
      </{{ ew_img_tag }}>
    </div>
  {% endblock -%}

  {%- if not has_video -%}
    <div class="cardTeaser-info">
      {% block slot_details %}
        <div class="cardTeaser-bundle">
          {{- card_teaser_bundle -}}
        </div>

        {%- if card_teaser_date -%}
          <div class="cardTeaser-date">
            {{- card_teaser_date -}}
          </div>
        {%- endif -%}
      {% endblock -%}
    </div>
  {%- endif -%}

  {% block slot_content -%}
    <div class="cardTeaser-content">
      {% block slot_title %}
        <{{ card_teaser_title_heading }} class="cardTeaser-title">
          {{- card_teaser_title -}}
        </{{ card_teaser_title_heading }}>
      {% endblock %}

      {% block slot_description %}
        {%- if card_teaser_description -%}
          <div class="cardTeaser-description">
            {{- card_teaser_description -}}
          </div>
        {%- endif -%}
      {% endblock -%}
    </div>
  {% endblock %}

  {% block slot_link %}
    <a class="cardTeaser-link stretched-link" href="{{ card_teaser_link }}">
      {{- card_teaser_link_text -}}
      {{- card_teaser_link_icon|raw -}}
    </a>
  {% endblock %}

  <{{ card_teaser_title_heading }} class="cardTeaser-hiddenTitle">
    {{ card_teaser_title }}
  </{{ card_teaser_title_heading }}>

  <div class="cardTeaser-hiddenDescription">
    {{ card_teaser_description }}
  </div>
</article>
