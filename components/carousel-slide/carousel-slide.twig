{#-
/**
 * @file
 * Carousel Slide component.
 *
 * Available props:
 * - carousel_slide_heading (string|null)
 * - carousel_slide_heading_tag (string) default: 'h2'
 * - carousel_slide_description (string|null) rendered HTML
 * - carousel_slide_image (string|null) URL
 * - carousel_slide_image_alt (string|null)
 * - carousel_slide_image_loading (eager|lazy) default: 'lazy'
 * - carousel_slide_cta (object|null) { url, title }
 *
 * Available utility classes -> uc
 * - carousel_slide_uc (array) (default: [])
 *
 * Available attributes -> att
 * - carousel_slide_att (Drupal\Core\Template\Attribute)
 */
-#}

{#- Defaults -#}
{% set carousel_slide_heading_tag = carousel_slide_heading_tag|default('h2') %}
{% set carousel_slide_image_loading = carousel_slide_image_loading|default('lazy') %}

{#- Attributes -#}
{% set carousel_slide_att = carousel_slide_att ?: create_attribute() %}

{#- Classes -#}
{% set slide_classes = [
  'c--carousel-slide'
]|merge(carousel_slide_uc ?: []) %}

<div{{ carousel_slide_att.addClass(slide_classes) }}>
  {%- if carousel_slide_heading or carousel_slide_description or carousel_slide_cta -%}
    <div class="slide-text">
      {%- if carousel_slide_heading -%}
        <{{ carousel_slide_heading_tag }} class="slide-heading">
          {{- carousel_slide_heading -}}
        </{{ carousel_slide_heading_tag }}>
      {%- endif -%}

      {%- if carousel_slide_description -%}
        <div class="slide-description">
          {{- carousel_slide_description -}}
        </div>
      {%- endif -%}

      {{- carousel_slide_cta -}}
    </div>
  {%- endif -%}

  {%- if carousel_slide_image -%}
    <div class="slide-media">
      {{- carousel_slide_image -}}
    </div>
  {%- endif -%}
</div>
