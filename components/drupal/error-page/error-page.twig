{#-
/**
 * @file
 * Template for the error-page component.
 *
 * Props:
 * - title: (string) required — main heading
 * - description: (string | null) default: null
 * - code: (string | int | null) default: null — HTTP error code
 * - primary_label: (string | null) default: null
 * - primary_url: (string | null) default: null
 * - secondary_label: (string | null) default: null
 * - secondary_url: (string | null) default: null
 * - illustration: (string | null) default: null — raw HTML/SVG
 *
 * Slots:
 * - slot_illustration: Custom illustration content
 */
-#}

<div class="c--error-page wrapper">
  <div class="ep_w_info">
    <h1 class="ep_title">
      {{- title -}}
    </h1>

    {%- if block('slot_ctas') is not empty -%}
      <div class="ep_description">
        {{- description -}}
      </div>
    {%- endif -%}

    {%- if code -%}
      <div class="ep_code">
        {{- 'Error Code:'|t }} {{ code -}}
      </div>
    {%- endif -%}

    {%- if block('slot_ctas') is not empty -%}
      <div class="ep_ctas">
        {%- block slot_ctas -%}
        {% endblock %}
      </div>
    {%- endif -%}


    {%- if block('slot_links') is not empty -%}
      <div class="ep_links">
        {% block slot_links %}
        {% endblock %}
      </div>
    {%- endif -%}
  </div>

  {%- if slot_illustration or illustration -%}
    <div class="ep_illustration" aria-hidden="true">
      {%- block slot_illustration -%}
        {{- illustration|raw -}}
      {%- endblock -%}
    </div>
  {%- endif -%}
</div>
