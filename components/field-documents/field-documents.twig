{#-
/**
  * @file
  * Field Documents component.
  *
  * Renders a documents field as a stacked list. Each item's rendered markup
  * (item.content) is passed through unchanged — media entities keep whatever
  * display their view mode produces.
  *
  * Available values:
  * - field_documents_items (array) (default: [])
  *   Each item: { content: renderable|string }
  * - field_documents_label (string|object|null) (default: null)
  * - field_documents_label_hidden (boolean) (default: false)
  *
  * Available Utility classes -> uc
  * - field_documents_uc (array) (default: [])
  *
  * Available attributes -> att
  * - field_documents_att (Drupal\Core\Template\Attribute)
  */
-#}

{#- Set default value -#}
{% set field_documents_items = field_documents_items|default([]) %}
{% set field_documents_label = field_documents_label|default(null) %}
{% set field_documents_label_hidden = field_documents_label_hidden|default(false) %}

{#- Create attributes -#}
{% set field_documents_att = field_documents_att ?: create_attribute() %}

{#- Component classes -#}
{% set field_documents_classes = [
  'c--field-documents',
]|merge(field_documents_uc ?: []) %}

{#- Render component -#}
<div{{ field_documents_att.addClass(field_documents_classes) }}>
  {% if field_documents_label and not field_documents_label_hidden %}
    {% include 'mud_egov:heading' with {
      heading_level: 3,
      heading_text: field_documents_label,
      heading_uc: ['field-documents__label'],
    } %}
  {% endif %}

  {% for item in field_documents_items %}
    <div class="field-documents__item">
      {{ item.content }}
    </div>
  {% endfor %}
</div>
