{#-
/**
  * @file
  * Field Icon component.
  *
  * Available values:
  * - field_icon_icon (string|null) (default: null)
  * - field_icon_value (string|null) (default: null)
  *
  * Available Utility classes -> uc
  * - field_icon_uc (array) (default: [])
  *
  * Available attributes -> att
  * - field_icon_att (Drupal\Core\Template\Attribute)
  *
  * Available slots
  * - slot_icon: The icon element (SVG, img, or icon component).
  * - slot_content: The field content displayed next to the icon.
  *
  * usage example: @see field-icon.md
  */
-#}

{#- Set default value -#}
{% set field_icon_icon = field_icon_icon|default(null) %}
{% set field_icon_value = field_icon_value|default(null) %}

{#- Create attributes -#}
{% set field_icon_att = field_icon_att ?: create_attribute() %}

{#- Component classes -#}
{% set field_icon_classes = [
  'c--field-icon',
]|merge(field_icon_uc ?: []) %}

{#- Render component -#}
<div{{ field_icon_att.addClass(field_icon_classes) }}>
  {%- if block('slot_icon') is not empty or field_icon_icon -%}
    {% block slot_icon %}
      {{- field_icon_icon|raw -}}
    {% endblock %}
  {%- endif -%}

  {% block slot_content -%}
    {{- field_icon_value -}}
  {% endblock %}
</div>
