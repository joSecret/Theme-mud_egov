{#-
/**
 * @file
 * Footer Contact component.
 *
 * Props: footer_contact_logo_src, footer_contact_logo_alt,
 * footer_contact_logo_url, footer_contact_phone, footer_contact_email,
 * footer_contact_address.
 * Utility classes: footer_contact_uc
 * Attributes: footer_contact_att
 * Slots: menu
 */
-#}
{%- set footer_contact_att = footer_contact_att ?: create_attribute() -%}
{%- set footer_contact_classes = ['c--footer-contact']|merge(footer_contact_uc ?: []) -%}
<div{{ footer_contact_att.addClass(footer_contact_classes) }}>
  {%- if footer_contact_logo_src -%}
    <a href="{{ footer_contact_logo_url ?: '/' }}" class="c--footer-contact__logo" rel="home">
      <img src="{{ footer_contact_logo_src }}" alt="{{ footer_contact_logo_alt ?: '' }}"{% if not footer_contact_logo_alt %} aria-hidden="true"{% endif %}>
    </a>
  {%- endif -%}

  {%- if footer_contact_phone -%}
    {%- include 'mud_egov:field-phone' with {
      field_phone_value: footer_contact_phone
    } -%}
  {%- endif -%}

  {%- if footer_contact_email -%}
    {%- include 'mud_egov:field-mail' with {
      field_mail_value:footer_contact_email
    } -%}
  {%- endif -%}

  {%- if footer_contact_address -%}
    <p class="c--footer-contact__address">
      {{- footer_contact_address|nl2br -}}
    </p>
  {%- endif -%}

  {%- if menu -%}
    <div class="c--footer-contact__menu">
      {{- menu -}}
    </div>
  {%- endif -%}
</div>
