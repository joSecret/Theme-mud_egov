{#-
/**
 * @file
 * Template for the Date Picker component (MUD-aligned).
 *
 * Renders a text input that opens a calendar popup when focused/clicked.
 * The calendar is built and controlled by date-picker.js.
 */
-#}

{% set date_picker_disabled = date_picker_disabled|default(false) %}
{% set date_picker_required = date_picker_required|default(false) %}
{% set date_picker_error = date_picker_error|default(false) %}
{% set date_picker_inline = date_picker_inline|default(false) %}
{% set date_picker_mode = date_picker_mode|default('single') %}
{% set date_picker_locale = date_picker_locale|default('ro-RO') %}
{% set date_picker_id = date_picker_id|default('date-picker-' ~ random()) %}
{% set date_picker_placeholder = date_picker_placeholder|default('ZZ/LL/AAAA') %}

{% set date_picker_att = date_picker_att ?: create_attribute() %}

{%
  set classes = [
    'date-picker',
    date_picker_size ? 'date-picker-' ~ date_picker_size,
    date_picker_error ? 'is-error',
    date_picker_disabled ? 'is-disabled',
    date_picker_inline ? 'date-picker-inline',
  ]|merge(date_picker_uc ?: [])
%}

<div
  {{ date_picker_att.addClass(classes) }}
  data-date-picker
  data-mode="{{ date_picker_mode }}"
  data-locale="{{ date_picker_locale }}"
  {%- if date_picker_min -%} data-min="{{ date_picker_min }}"{%- endif -%}
  {%- if date_picker_max -%} data-max="{{ date_picker_max }}"{%- endif -%}
>
  {%- if date_picker_label -%}
    <label class="date-picker-label" for="{{ date_picker_id }}">
      {{- date_picker_label -}}
      {%- if date_picker_required -%}<span class="date-picker-required" aria-hidden="true"> *</span>{%- endif -%}
    </label>
  {%- endif -%}

  <div class="date-picker-field">
    <input
      type="text"
      id="{{ date_picker_id }}"
      class="date-picker-input"
      placeholder="{{ date_picker_placeholder }}"
      value="{{ date_picker_value|default('') }}"
      {%- if date_picker_name -%} name="{{ date_picker_name }}"{%- endif -%}
      {%- if date_picker_disabled -%} disabled{%- endif -%}
      {%- if date_picker_required -%} required aria-required="true"{%- endif -%}
      {%- if date_picker_error -%} aria-invalid="true"{%- endif -%}
      autocomplete="off"
      readonly
    >
    <span class="date-picker-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
  </div>

  {#- Calendar popup — built/managed by JS -#}
  {%- if not date_picker_inline -%}
    <div class="date-picker-popup" hidden aria-modal="true" role="dialog" aria-label="{{ date_picker_label ?: 'Selectează data' }}">
      <div class="date-picker-calendar" data-date-picker-calendar></div>
    </div>
  {%- else -%}
    <div class="date-picker-calendar date-picker-calendar-inline" data-date-picker-calendar></div>
  {%- endif -%}

  {%- if date_picker_error and date_picker_error_message -%}
    <p class="date-picker-error" role="alert">{{ date_picker_error_message }}</p>
  {%- elseif date_picker_helper_text -%}
    <p class="date-picker-helper">{{ date_picker_helper_text }}</p>
  {%- endif -%}
</div>
