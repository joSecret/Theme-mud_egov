{#-
/**
 * @file
 * Template for the Search Input Circular component (MUD-aligned).
 *
 * Props:
 * - search_circular_label (string|null) default: null
 * - search_circular_placeholder (string|null) default: null
 * - search_circular_name (string|null) default: null
 * - search_circular_id (string|null) default: null
 * - search_circular_value (string|null) default: null
 * - search_circular_button_label (string) default: 'Caută'
 *
 * Variations:
 * - search_circular_size (string|null) default: null — md | lg
 * - search_circular_disabled (boolean) default: false
 * - search_circular_required (boolean) default: false
 * - search_circular_with_button (boolean) default: false
 *
 * Utility classes: search_circular_uc
 * Attributes: search_circular_att
 */
-#}

{#- Defaults -#}
{% set search_circular_id = search_circular_id|default(search_circular_name) %}
{% set search_circular_disabled = search_circular_disabled|default(false) %}
{% set search_circular_required = search_circular_required|default(false) %}
{% set search_circular_with_button = search_circular_with_button|default(false) %}
{% set search_circular_with_clear = search_circular_with_clear|default(false) %}
{% set search_circular_button_label = search_circular_button_label|default('Caută') %}

{#- IDs for aria wiring -#}
{% set label_id = search_circular_id ? 'label-' ~ search_circular_id : null %}

{#- Create attributes -#}
{% set search_circular_att = search_circular_att ?: create_attribute() %}

{#- Component classes -#}
{%
  set classes = [
    'c--search-input-circular',
    search_circular_size ? 'c--search-input-circular--' ~ search_circular_size,
    search_circular_disabled ? 'is-disabled',
    search_circular_with_button ? 'has-button',
  ]|merge(search_circular_uc ?: [])
%}

{#- Render -#}
<div{{ search_circular_att.addClass(classes) }}>
  {%- if search_circular_label -%}
    <label
      class="search-circular-label"
      {%- if search_circular_id -%} for="{{ search_circular_id }}"{%- endif -%}
      {%- if label_id -%} id="{{ label_id }}"{%- endif -%}
    >
      {{- search_circular_label -}}
      {%- if search_circular_required -%}
        <span class="search-circular-required" aria-hidden="true">*</span>
      {%- endif -%}
    </label>
  {%- endif -%}

  <div class="search-circular-control">
    <span class="search-circular-icon-start" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
    </span>

    <input
      class="search-circular-field"
      type="search"
      {%- if search_circular_id -%} id="{{ search_circular_id }}"{%- endif -%}
      {%- if search_circular_name -%} name="{{ search_circular_name }}"{%- endif -%}
      {%- if search_circular_value -%} value="{{ search_circular_value }}"{%- endif -%}
      {%- if search_circular_placeholder -%} placeholder="{{ search_circular_placeholder }}"{%- endif -%}
      {%- if search_circular_required -%} required aria-required="true"{%- endif -%}
      {%- if search_circular_disabled -%} disabled aria-disabled="true"{%- endif -%}
      {%- if label_id -%} aria-labelledby="{{ label_id }}"{%- endif -%}
      autocomplete="off"
    >

    {%- if search_circular_with_clear -%}
      <button
        class="search-circular-clear"
        type="button"
        aria-label="{{ 'Șterge'|t }}"
        {%- if search_circular_disabled -%} disabled aria-disabled="true"{%- endif -%}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if search_circular_with_button -%}
      <button
        class="search-circular-button"
        type="submit"
        aria-label="{{ search_circular_button_label }}"
        {%- if search_circular_disabled -%} disabled aria-disabled="true"{%- endif -%}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="visually-hidden">{{ search_circular_button_label }}</span>
      </button>
    {%- endif -%}
  </div>
</div>
