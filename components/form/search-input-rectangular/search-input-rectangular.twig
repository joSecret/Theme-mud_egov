{#-
/**
 * @file
 * Template for the Search Input Rectangular component (MUD-aligned).
 *
 * Props:
 * - search_input_rectangular_label (string|null) default: null
 * - search_input_rectangular_placeholder (string|null) default: null
 * - search_input_rectangular_name (string|null) default: null
 * - search_input_rectangular_id (string|null) default: null
 * - search_input_rectangular_value (string|null) default: null
 * - search_input_rectangular_button_label (string) default: 'Caută'
 *
 * Variations:
 * - search_input_rectangular_size (string|null) default: null — md | lg
 * - search_input_rectangular_disabled (boolean) default: false
 * - search_input_rectangular_required (boolean) default: false
 * - search_input_rectangular_show_button (boolean) default: false
 *
 * Utility classes: search_input_rectangular_uc
 * Attributes: search_input_rectangular_att
 */
-#}

{#- Defaults -#}
{% set search_input_rectangular_id = search_input_rectangular_id|default(search_input_rectangular_name) %}
{% set search_input_rectangular_disabled = search_input_rectangular_disabled|default(false) %}
{% set search_input_rectangular_required = search_input_rectangular_required|default(false) %}
{% set search_input_rectangular_show_button = search_input_rectangular_show_button|default(false) %}
{% set search_input_rectangular_button_label = search_input_rectangular_button_label|default('Caută') %}

{#- IDs for aria wiring -#}
{% set label_id = search_input_rectangular_id ? 'label-' ~ search_input_rectangular_id : null %}

{#- Create attributes -#}
{% set search_input_rectangular_att = search_input_rectangular_att ?: create_attribute() %}

{#- Component classes -#}
{%
  set classes = [
    'c--search-input-rectangular',
    search_input_rectangular_size ? 'c--search-input-rectangular--' ~ search_input_rectangular_size,
    search_input_rectangular_disabled ? 'is-disabled',
    search_input_rectangular_show_button ? 'has-button',
  ]|merge(search_input_rectangular_uc ?: [])
%}

{#- Render -#}
<div{{ search_input_rectangular_att.addClass(classes) }}>
  {%- if search_input_rectangular_label -%}
    <label
      class="search-rect-label"
      {%- if search_input_rectangular_id -%} for="{{ search_input_rectangular_id }}"{%- endif -%}
      {%- if label_id -%} id="{{ label_id }}"{%- endif -%}
    >
      {{- search_input_rectangular_label -}}
      {%- if search_input_rectangular_required -%}
        <span class="search-rect-required" aria-hidden="true">*</span>
      {%- endif -%}
    </label>
  {%- endif -%}

  <div class="search-rect-control">
    <span class="search-rect-icon-start" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
    </span>

    <input
      class="search-rect-field"
      type="search"
      {%- if search_input_rectangular_id -%} id="{{ search_input_rectangular_id }}"{%- endif -%}
      {%- if search_input_rectangular_name -%} name="{{ search_input_rectangular_name }}"{%- endif -%}
      {%- if search_input_rectangular_value -%} value="{{ search_input_rectangular_value }}"{%- endif -%}
      {%- if search_input_rectangular_placeholder -%} placeholder="{{ search_input_rectangular_placeholder }}"{%- endif -%}
      {%- if search_input_rectangular_required -%} required aria-required="true"{%- endif -%}
      {%- if search_input_rectangular_disabled -%} disabled aria-disabled="true"{%- endif -%}
      {%- if label_id -%} aria-labelledby="{{ label_id }}"{%- endif -%}
      autocomplete="off"
    >

    {%- if search_input_rectangular_show_button -%}
      <button
        class="search-rect-button"
        type="submit"
        aria-label="{{ search_input_rectangular_button_label }}"
        {%- if search_input_rectangular_disabled -%} disabled aria-disabled="true"{%- endif -%}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <span class="visually-hidden">{{ search_input_rectangular_button_label }}</span>
      </button>
    {%- endif -%}
  </div>
</div>
