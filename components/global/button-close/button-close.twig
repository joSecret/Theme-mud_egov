{#-
/**
  * @file
  * Button Close — icon-only dismiss control.
  *
  * Self-contained 32px icon button; the color comes from the parent context
  * (currentcolor). Closes the nearest [data-dismissable] ancestor.
  *
  * Props:
  * - button_close_label (string)     aria-label. Default: "Închide".
  * - button_close_icon  (string|null) SVG override. Default: built-in X.
  * - button_close_uc    (array)      Utility classes.
  * - button_close_att   (Attribute)  Extra HTML attributes.
  *
  * @see button-close.md
  */
-#}

{#- Defaults -#}
{% set button_close_label = button_close_label|default('Închide') %}
{% set button_close_att = button_close_att ?: create_attribute() %}

{#- Classes -#}
{% set button_close_classes = [
  'button-close',
]|merge(button_close_uc ?: []) %}

{#- Attributes -#}
{% set button_close_att = button_close_att
  .setAttribute('type', 'button')
  .setAttribute('aria-label', button_close_label) %}

<button{{ button_close_att.addClass(button_close_classes) }}>
  {%- if button_close_icon -%}
    {{- button_close_icon|raw -}}
  {%- else -%}
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16">
      <path d="M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z"/>
    </svg>
  {%- endif -%}
</button>
