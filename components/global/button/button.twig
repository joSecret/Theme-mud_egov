{#-
/**
 * @file
 * Template for a button component.
 *
 * Props:
 * - button_tag: (string | null) default: ('button' | 'a' when button_url set)
 *    enum: a | button | span | input | summary
 * - button_variant: (string | null) default: (null = primary)
 *    enum: null | primary | secondary | strict | neutral | destructive
 * - button_appearance: (string | null) default: (null = filled)
 *    enum: null | filled | outlined | text
 * - button_size: (string | null) default: (null = md)
 *    enum: null | sm | md | lg
 * - button_shape: (string | null) default: (null = rectangular)
 *    enum: null | none | rectangular | circular
 * - button_icon_position: (string | null) default: ('right' when an icon is set)
 *    enum: null | left | right | only
 * - button_disabled: (boolean) default: (false)
 * - button_loading: (boolean) default: (false)
 * - button_full_width: (boolean) default: (false)
 * - button_aria_expanded: (boolean | null) default: (null)
 *
 * Values:
 * - button_label: (string) default: ('')
 * - button_aria_label: (string | null) default: (null) - Required for icon-only
 * - button_url: (string | null) default: (null)
 * - button_target: (string | null) default: (null)
 * - button_rel: (string | null) default: (null)
 * - button_name: (string | null) default: (null)
 * - button_value: (string | null) default: (null)
 * - button_icon: (string | null) default: (null) - SVG with aria-hidden="true"
 * - button_icon_second: (string | null) default: (null)
 * - button_id: (string | null) default: (null)
 * - button_role: (string | null) default: (null)
 *
 * Utility classes: button_uc
 * Attributes: button_att
 *
 * Slots:
 * - slot_icon: Icon (left, right or only)
 * - slot_content: Main content
 * - slot_icon_second: Second icon
 */
-#}

{#- Defaults -#}
{% set button_tag = button_tag|default(button_url ? 'a' : 'button') %}
{% set button_variant = button_variant|default(null) %}
{% set button_appearance = button_appearance|default(null) %}
{% set button_size = button_size|default(null) %}
{% set button_shape = button_shape|default(null) %}
{% set button_disabled = button_disabled|default(false) %}
{% set button_loading = button_loading|default(false) %}
{% set button_full_width = button_full_width|default(false) %}
{% set button_aria_expanded = button_aria_expanded is same as(true) or button_aria_expanded is same as(false) ? button_aria_expanded : null %}
{% set button_icon_position = button_icon_position|default(button_icon ? 'right' : null) %}

{% set button_att = button_att ?: create_attribute() %}

{#- Component classes -#}
{%
  set button_classes = [
    'button',
    button_variant ? 'button-' ~ button_variant,
    button_appearance ? 'button-' ~ button_appearance,
    button_size ? 'button-' ~ button_size,
    button_icon_position ? 'button-icon-' ~ button_icon_position,
    button_shape ? 'button-' ~ button_shape,
    button_full_width ? 'button-full-width',
    button_loading ? 'is-loading',
  ]|merge(button_uc ?: [])
%}

{#- Link attributes -#}
{%- if button_url -%}
  {% set button_att = button_att.setAttribute('href', button_url) %}
  {%- if button_target -%}
    {% set button_att = button_att.setAttribute('target', button_target) %}
  {%- endif -%}
  {%- if button_rel -%}
    {% set button_att = button_att.setAttribute('rel', button_rel) %}
  {%- endif -%}
{%- endif -%}

{#- Form attributes -#}
{%- if button_name -%}
  {% set button_att = button_att.setAttribute('name', button_name) %}
{%- endif -%}
{%- if button_value -%}
  {% set button_att = button_att.setAttribute('value', button_value) %}
{%- endif -%}

{%- if button_loading -%}
  {% set button_att = button_att.setAttribute('aria-busy', 'false') %}
{%- endif -%}

{#- Disabled -#}
{%- if button_disabled -%}
  {%- if button_tag in ['button', 'input'] -%}
    {% set button_att = button_att.setAttribute('disabled', true) %}
  {%- else -%}
    {% set button_att = button_att
      .setAttribute('role', 'link')
      .setAttribute('aria-disabled', 'true')
      .setAttribute('tabindex', '-1')
    %}
  {%- endif -%}
{%- endif -%}

{#- aria-expanded only when explicitly set -#}
{%- if button_aria_expanded is not null -%}
  {% set button_att = button_att.setAttribute('aria-expanded', button_aria_expanded ? 'true' : 'false') %}
{%- endif -%}

{%- if button_role -%}
  {% set button_att = button_att.setAttribute('role', button_role) %}
{%- endif -%}

{#- aria-label -#}
{%- if button_aria_label -%}
  {% set button_att = button_att.setAttribute('aria-label', button_aria_label) %}
{%- elseif button_icon_position == 'only' and not button_label -%}
  {% set button_att = button_att.setAttribute('aria-label', 'Button'|t) %}
{%- endif -%}

{%- if button_id -%}
  {% set button_att = button_att.setAttribute('id', button_id) %}
{%- endif -%}

{#- type for <button> elements -#}
{%- if button_tag == 'button' and not button_att.offsetGet('type') -%}
  {% set button_att = button_att.setAttribute('type', 'button') %}
{%- endif -%}

{#- The spinner keeps the contrast of the label it replaces. -#}
{% set button_on_color = button_appearance in [null, 'filled'] and button_variant in [null, 'primary', 'strict', 'destructive'] %}

{#- Render -#}
{%- if button_tag == 'input' -%}
  {#- <input> is a void element: the label is its value. -#}
  {%- if not button_att.offsetGet('value') -%}
    {% set button_att = button_att.setAttribute('value', button_label) %}
  {%- endif -%}
  <input{{ button_att.addClass(button_classes) }}>
{%- else -%}
<{{ button_tag }}{{ button_att.addClass(button_classes) }}>
  {%- block slot_icon -%}
    {{- button_icon|raw -}}
  {%- endblock -%}

  {%- block slot_content -%}
    <span{{ button_icon_position == 'only' ? ' class="visually-hidden"' }}>
      {{- button_label -}}
    </span>
  {%- endblock -%}

  {%- if button_loading -%}
    {%- include 'mud_egov:spinner' with {
      spinner_size: button_size == 'sm' ? 'xs' : 'sm',
      spinner_variant: button_on_color ? 'light-on-color' : 'brand',
    } only -%}
  {%- endif -%}

  {%- if button_icon_position != 'only' -%}
    {%- block slot_icon_second -%}
      {{- button_icon_second|raw -}}
    {%- endblock -%}
  {%- endif -%}
</{{ button_tag }}>
{%- endif -%}
