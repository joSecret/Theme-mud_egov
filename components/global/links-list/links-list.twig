{#-
/**
 * @file
 * Template for the LinksList component.
 *
 * Available props:
 * - links_links: (array) List of link items with link, text, attributes, text_attributes.
 * - links_orientation: (string|null) 'vertical' | 'horizontal'.
 * - links_uc:          (array) Utility classes for the <ul>.
 * - links_att:         (Drupal\Core\Template\Attribute) Extra attributes for the <ul>.
 */
-#}

{% set links_att = links_att ?: create_attribute() %}
{%
  set links_classes = [
    'c--links-list',
    links_orientation ? 'links-list-' ~ links_orientation,
  ]|merge(links_uc ?: [])
%}

<ul{{ links_att.addClass(links_classes) }}>
  {%- for key, item in links_links -%}
    {% set item_link = item.link|merge({'#title': key|capitalize}) %}
    <li{{ item.attributes }}>
      {%- if item.link -%}
        {{- item_link -}}
      {%- elseif item.text_attributes -%}
        <span{{ item.text_attributes }}>
          {{- key|capitalize -}}
        </span>
      {%- else -%}
        {{- key|capitalize -}}
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
