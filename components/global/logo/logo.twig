{#-
/**
 * @file
 * Template for the Logo component.
 *
 * Props:
 * - logo_name: (string|null) default: (null) — MUD mud-logo asset name
 * - logo_src: (string|null) default: (null) — custom image URL
 * - logo_alt: (string|null) default: (null) — accessible alt text
 * - logo_url: (string|null) default: (null) — wraps in <a> when set
 * - logo_title: (string|null) default: (null) — title attribute
 * - logo_size: (string|null) default: (null) — sm | md | lg
 * - logo_variant: (string|null) default: (null) — color | white | black
 *
 * Utility classes: logo_uc
 * Attributes: logo_att
 */
-#}

{#- Defaults -#}
{% set logo_name = logo_name|default(null) %}
{% set logo_src = logo_src|default(null) %}
{% set logo_alt = logo_alt|default(null) %}
{% set logo_url = logo_url|default(null) %}
{% set logo_title = logo_title|default(null) %}
{% set logo_size = logo_size|default(null) %}
{% set logo_variant = logo_variant|default(null) %}

{#- Create attributes -#}
{% set logo_att = logo_att ?: create_attribute() %}

{#- Component classes -#}
{% set logo_classes = [
  'c--logo',
  logo_size ? 'c--logo--' ~ logo_size,
  logo_variant ? 'c--logo--' ~ logo_variant,
]|merge(logo_uc ?: []) %}

{#- Inner markup — mud-logo web component or <img> -#}
{%- if logo_name -%}
  {% set logo_inner %}
    <mud-logo
      name="{{ logo_name }}"
      {%- if logo_alt -%} aria-label="{{ logo_alt }}"{%- endif -%}
    ></mud-logo>
  {% endset -%}
{%- elseif logo_src -%}
  {% set logo_inner %}
    <img
      src="{{ logo_src }}"
      {%- if logo_alt -%} alt="{{ logo_alt }}"{%- else -%} alt="" aria-hidden="true"{%- endif -%}
      {%- if logo_title -%} title="{{ logo_title }}"{%- endif -%}
      class="c--logo__img"
    >
  {% endset -%}
{%- endif -%}

{#- Render component -#}
<div{{ logo_att.addClass(logo_classes) }}>
  {%- if logo_url -%}
    <a
      href="{{ logo_url }}"
      class="c--logo__link"
      {%- if logo_title -%} title="{{ logo_title }}"{%- endif -%}
    >
      {{- logo_inner|raw -}}
    </a>
  {%- else -%}
    {{- logo_inner|raw -}}
  {%- endif -%}
</div>
