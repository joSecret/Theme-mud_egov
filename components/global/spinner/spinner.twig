{#-
/**
 * @file
 * Template for the Spinner component.
 *
 * Props:
 * - spinner_size: (string | null) default: (null)
 *    enum: null | xs | sm | md | lg
 * - spinner_variant: (string | null) default: (null)
 *    enum: null | brand | dark | light | light-on-color
 * - spinner_label: (string) default: ('Loading')
 *
 * Utility classes: spinner_uc
 * Attributes: spinner_att
 */
-#}

{# button.twig (componenta model, neschimbată) trimite încă size/variant/label: le acceptăm ca rezervă. #}
{% set spinner_size = spinner_size|default(size|default(null)) %}
{% set spinner_variant = spinner_variant|default(variant|default(null)) %}
{% set spinner_label = spinner_label|default(label|default('Loading')) %}

{% set spinner_att = spinner_att ?: create_attribute() %}

{%
  set spinner_classes = [
    'spinner',
    spinner_size ? 'spinner-' ~ spinner_size,
    spinner_variant ? 'spinner-' ~ spinner_variant,
  ]|merge(spinner_uc ?: [])
%}

{% set spinner_att = spinner_att
  .setAttribute('role', 'status')
  .setAttribute('aria-label', spinner_label)
  .setAttribute('aria-live', 'polite')
%}

<span{{ spinner_att.addClass(spinner_classes) }}>
  <span class="arc" aria-hidden="true"></span>
</span>
