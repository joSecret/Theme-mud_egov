{#-
/**
  * @file
  * Content layout component: content area with an optional sidebar.
  *
  * Available variations:
  * - content_layout_type: null (col_1), col_1, col_1_full, col_2_sidebar, full
  *
  * Available Utility classes -> uc
  * - content_uc (array)
  * - content_sidebar_uc (array)
  * - content_main_uc (array)
  *
  * Available attributes -> att
  * - content_att (Drupal\Core\Template\Attribute)
  * - content_sidebar_att (Drupal\Core\Template\Attribute)
  * - content_main_att (Drupal\Core\Template\Attribute)
  *
  * Available slots:
  * - cls_addons: title prefix, title suffix or other extra information
  * - sidebar: shown only for the col_2* layouts
  * - content: the main content
  *
  * usage example: @see content.md
  */
-#}

{#- Set default value -#}
{% set content_layout_type = content_layout_type ?: 'col_1' %}

{#- Create attributes -#}
{% set content_att = content_att ?: create_attribute() %}
{% set content_sidebar_att = content_sidebar_att ?: create_attribute() %}
{% set content_main_att = content_main_att ?: create_attribute() %}

{% set content_has_sidebar = content_layout_type starts with 'col_2' %}

{#- Component classes -#}
{%
  set content_classes = [
    'grid-container',
    content_has_sidebar ? 'comp-sidebar',
    content_has_sidebar ? 'cls--layout-type_' ~ content_layout_type|clean_class,
  ]|merge(content_uc ?: [])
%}

{% set content_sidebar_classes = [
  'slot-sidebar',
]|merge(content_sidebar_uc ?: []) %}

{% set content_main_classes = [
  'slot-content',
]|merge(content_main_uc ?: []) %}

{#- Render component -#}
<div{{ content_att.addClass(content_classes) }}>
  {% block cls_addons %}{% endblock %}

  {%- if block('sidebar') is defined and content_has_sidebar -%}
    <button class="js--show-sidebar btn d-lg-none btn-secondary btn-only-icon" aria-expanded="false">
      {{- "Show sidebar"|t -}}
    </button>

    <div{{ content_sidebar_att.addClass(content_sidebar_classes) }}>
      {% block sidebar %}{% endblock %}
    </div>
  {%- endif -%}

  {%- if block('content') is defined -%}
    <div{{ content_main_att.addClass(content_main_classes) }}>
      {% block content %}{% endblock %}
    </div>
  {%- endif -%}
</div>
