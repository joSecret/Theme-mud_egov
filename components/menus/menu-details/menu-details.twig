{#-
/**
  * @file
  * Menu details component.
  *
  * Available values:
  * - menu_details_items (array) required
  *
  * Available Utility classes -> uc
  * - menu_details_uc (array) (default: [''])
  *
  * Available attributes -> att
  * - menu_details_att (Drupal\Core\Template\Attribute)
  *
  * usage example: @see menu-details.md
  *
  */
-#}

{#- Set default value -#}

{#- Create attributes -#}
{% set menu_details_att = menu_details_att ?: create_attribute() %}

{#- Component classes -#}
{% set menu_details_classes = [
  'c--menu-details',
]|merge(menu_details_uc ?: []) %}

{#- Change attributes -#}

{#- Render component -#}
<div{{ menu_details_att.addClass(menu_details_classes) }}>
  {%- import _self as menus -%}
  {{- menus.menu_links(menu_details_items, 0) -}}
</div>

{% macro menu_links(menu_items, menu_level) %}
  {% import _self as menus %}
  {%- if menu_items -%}
    <ul>
      {% for item in menu_items -%}
        {%- set item_classes = [
          'menu-details_level_' ~ menu_level,
          item.in_active_trail ? 'is-link_active-trail',
          item.below ? 'is-link_has-children',
        ] -%}
        <li{{ item.attributes.addClass(item_classes) }}>
          {%- if item.below -%}
            <details>
              <summary class="menu-item">
                {{- item.title -}}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24">
                  <path fill="currentColor" fill-rule="evenodd" d="M4.334 8.252a.799.799 0 0 1 1.13 0l5.846 5.846a.976.976 0 0 0 1.38 0l5.846-5.846a.799.799 0 0 1 1.13 1.13l-5.846 5.846a2.574 2.574 0 0 1-3.64 0L4.334 9.382a.799.799 0 0 1 0-1.13z" clip-rule="evenodd"></path>
                </svg>
              </summary>

              {{- menus.menu_links(item.below, menu_level + 1) -}}
            </details>
          {%- else -%}
            {{- link(item.title, item.url, { class: ['menu-item'] }) -}}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{% endmacro -%}
