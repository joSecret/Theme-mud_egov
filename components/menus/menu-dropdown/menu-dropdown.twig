{#-
/**
 * @file
 * Menu dropdown component — dropdown/context menu.
 *
 * Props:
 * - menu_dropdown_items: (array) [{label, url, icon, disabled, divider}] default: []
 * - menu_dropdown_trigger_label: (string|null) default: null
 * - menu_dropdown_type: (string|null) enum: contextual|selection default: null
 * - menu_dropdown_position: (string|null) enum: bottom-start|bottom-end|top-start|top-end default: null
 * - menu_dropdown_open: (boolean) default: false
 * - menu_dropdown_uc: (array) default: []
 * - menu_dropdown_att: (Drupal\Core\Template\Attribute) default: null
 *
 * Slots:
 * - slot_trigger: Custom trigger element (must include data-menu-trigger)
 *
 * @see menu-dropdown.md
 */
-#}

{#- Defaults -#}
{% set menu_dropdown_items = menu_dropdown_items|default([]) %}
{% set menu_dropdown_trigger_label = menu_dropdown_trigger_label|default(null) %}
{% set menu_dropdown_type = menu_dropdown_type|default('contextual') %}
{% set menu_dropdown_position = menu_dropdown_position|default('bottom-start') %}
{% set menu_dropdown_open = menu_dropdown_open|default(false) %}

{% set menu_dropdown_id = 'menu-dropdown-' ~ random() %}
{% set menu_dropdown_panel_id = menu_dropdown_id ~ '-panel' %}

{#- Determine ARIA role based on type -#}
{% set menu_dropdown_role = menu_dropdown_type == 'selection' ? 'listbox' : 'menu' %}
{% set menu_dropdown_item_role = menu_dropdown_type == 'selection' ? 'option' : 'menuitem' %}

{#- Create attributes -#}
{% set menu_dropdown_att = menu_dropdown_att ?: create_attribute() %}

{#- Component classes -#}
{% set menu_dropdown_classes = [
  'c--menu-dropdown',
  menu_dropdown_type ? 'has-type_' ~ menu_dropdown_type,
  menu_dropdown_position ? 'has-position_' ~ menu_dropdown_position|clean_class,
  menu_dropdown_open ? 'is-open',
]|merge(menu_dropdown_uc ?: []) %}

{#- Render -#}
<div{{ menu_dropdown_att.addClass(menu_dropdown_classes) }}>
  <div class="c--menu-dropdown__trigger">
    {%- if slot_trigger -%}
      {{- slot_trigger -}}
    {%- else -%}
    {%- block slot_trigger -%}
      <button
        class="button button-secondary button-outlined c--menu-dropdown__trigger-btn"
        type="button"
        data-menu-trigger
        aria-haspopup="{{ menu_dropdown_role }}"
        aria-expanded="{{ menu_dropdown_open ? 'true' : 'false' }}"
        aria-controls="{{ menu_dropdown_panel_id }}"
      >
        <span>{{ menu_dropdown_trigger_label }}</span>
        <span class="c--menu-dropdown__trigger-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="20" height="20">
            <path fill="currentColor" fill-rule="evenodd" d="M4.334 8.252a.799.799 0 0 1 1.13 0l5.846 5.846a.976.976 0 0 0 1.38 0l5.846-5.846a.799.799 0 0 1 1.13 1.13l-5.846 5.846a2.574 2.574 0 0 1-3.64 0L4.334 9.382a.799.799 0 0 1 0-1.13z" clip-rule="evenodd"></path>
          </svg>
        </span>
      </button>
    {%- endblock -%}
    {%- endif -%}
  </div>

  <div
    class="c--menu-dropdown__panel"
    id="{{ menu_dropdown_panel_id }}"
    role="{{ menu_dropdown_role }}"
    data-menu-panel
    tabindex="-1"
  >
    {% for item in menu_dropdown_items %}
      {%- if item.divider -%}
        <div class="c--menu-dropdown__divider" role="separator" aria-hidden="true"></div>
      {%- else -%}
        {% set item_classes = [
          'c--menu-dropdown__item',
          item.disabled ? 'is-disabled',
        ] %}
        {%- if item.url and not item.disabled -%}
          <a
            class="{{ item_classes|join(' ') }}"
            href="{{ item.url }}"
            role="{{ menu_dropdown_item_role }}"
          >
            {%- if item.icon -%}
              <span class="c--menu-dropdown__item-icon" aria-hidden="true">{{ item.icon|raw }}</span>
            {%- endif -%}
            <span class="c--menu-dropdown__item-label">{{ item.label }}</span>
          </a>
        {%- else -%}
          <button
            class="{{ item_classes|join(' ') }}"
            type="button"
            role="{{ menu_dropdown_item_role }}"
            {%- if item.disabled -%}aria-disabled="true" disabled{%- endif -%}
          >
            {%- if item.icon -%}
              <span class="c--menu-dropdown__item-icon" aria-hidden="true">{{ item.icon|raw }}</span>
            {%- endif -%}
            <span class="c--menu-dropdown__item-label">{{ item.label }}</span>
          </button>
        {%- endif -%}
      {%- endif -%}
    {% endfor -%}
  </div>
</div>
