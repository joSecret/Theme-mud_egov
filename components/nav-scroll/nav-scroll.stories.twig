{% stories NavScroll with {
  title: 'Components/Nav Scroll',
  argTypes: {
    navigation: {
      control: 'boolean'
    },
    itemCount: {
      control: 'number'
    }
  }
} %}

  {% story default with {
    name: 'Default',
    args: {
      navigation: true,
      itemCount: 8
    }
  } %}
    <div style="max-width: 600px;">
      {% embed 'mud_egov:nav-scroll' with {
        nav_scroll_navigation: navigation
      } %}
        {% block slot_content %}
          {% for i in 1..itemCount %}
            <div{%- if i == 1 -%} class="active"{%- endif -%}>
              Section {{ i }}
            </div>
          {% endfor -%}
        {% endblock %}
      {% endembed %}
    </div>
  {% endstory %}

  {% story withoutNavigation with {
    name: 'Without Navigation Buttons',
    args: {
      navigation: false,
      itemCount: 10
    }
  } %}
    <div style="max-width: 600px;">
      <nav>
        {% embed 'mud_egov:nav-scroll' with {
          nav_scroll_navigation: navigation
        } %}
          {% block slot_content %}
            {% for i in 1..itemCount %}
              <button type="button" {%- if i == 3 -%} class="active"{%- endif -%}>
                Section {{ i }}
              </button>
            {% endfor -%}
          {% endblock %}
        {% endembed %}
      </nav>
    </div>
  {% endstory %}

  {% story withFilters with {
    name: 'Small list',
    args: {
      navigation: true,
      itemCount: 6
    }
  } %}
    <div style="max-width: 700px;">
      {% embed 'mud_egov:nav-scroll' with {
        nav_scroll_navigation: navigation
      } %}
        {% block slot_content %}
          <div class="form-item">
            <input type="radio" id="filter-all" name="filter" value="all" checked>
            <label for="filter-all">All</label>
          </div>
          <div class="form-item">
            <input type="radio" id="filter-news" name="filter" value="news">
            <label for="filter-news" >News</label>
          </div>
          <div class="form-item">
            <input type="radio" id="filter-events" name="filter" value="events">
            <label for="filter-events" >Events</label>
          </div>
          <div class="form-item">
            <input type="radio" id="filter-articles" name="filter" value="articles">
            <label for="filter-articles" >Articles</label>
          </div>
          <div class="form-item">
            <input type="radio" id="filter-resources" name="filter" value="resources">
            <label for="filter-resources" >Resources</label>
          </div>
          <div class="form-item">
            <input type="radio" id="filter-videos" name="filter" value="videos">
            <label for="filter-videos" >Videos</label>
          </div>
        {% endblock %}
      {% endembed %}
    </div>
  {% endstory %}
{% endstories %}
