{#-
/**
 * @file
 * Navbar component.
 *
 * Available Utility classes -> uc
 * - navbar_uc (array) (default: [''])
 *
 * Available attributes -> att
 * - navbar_att (Drupal\Core\Template\Attribute)
 *
 * Renders the page regions: page.branding, page.header_mobil, page.nav_search,
 * page.nav_main, page.nav_additional, page.header and page.header_notifications.
 *
 * usage example: @see navbar.md
 */
-#}

{#- Create attributes -#}
{% set navbar_att = navbar_att ?: create_attribute() %}

{#- Component classes -#}
{% set navbar_classes = [
  'c--navbar',
]|merge(navbar_uc ?: []) %}

<div class="border_b bg-white">
  <div{{navbar_att.addclass(navbar_classes)}}>
    {{- page.branding|merge({'#attributes': {'class': ['nav_brand']}}) -}}

    <div class='nav_mob'>
      {{- page.header_mobil -}}

      <div>
        {% include "mud_egov:button" with {
          id:'js-nav-mob-toggle',
          aria_expanded: false,
          label: "Show main menu",
          variant: 'secondary',
          appearance: 'text',
          shape: 'circular',
          icon_position: 'only',
          icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="24" height="24"><path fill="currentColor" d="M21 17.1l.092.005a.9.9 0 0 1 0 1.79L21 18.9H3a.9.9 0 0 1 0-1.8zm0-6l.092.004a.9.9 0 0 1 0 1.792L21 12.9H3a.9.9 0 0 1 0-1.8zm0-6l.092.004a.9.9 0 0 1 0 1.792L21 6.9H3a.9.9 0 0 1 0-1.8z"></path></svg>'
        } %}
      </div>
    </div>

    <div class='w-main'>
      {{- page.nav_search|merge({'#attributes': {'class': ['nav_search']}}) -}}

      {{- page.nav_main|merge({'#attributes': {'class': ['nav_menu']}}) -}}

      {{- page.nav_additional|merge({'#attributes': {'class': ['nav_additional']}}) -}}

      {{- page.header|merge({'#attributes': {'class': ['nav_user']}}) -}}
    </div>
  </div>
</div>

{{- page.header_notifications -}}
