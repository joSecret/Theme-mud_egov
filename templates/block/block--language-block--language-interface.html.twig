{#
/**
 * @file
 * mud_egov's override for the Language switcher block.
 */
#}

{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}

{% set block_id = plugin_id|clean_class %}
{% set block_btn_att = create_attribute()
    .setAttribute('style', 'anchor-name: --' ~ block_id ~ '; --btn-icon_svg_w: 20px;')
    .setAttribute('popovertarget', block_id) %}

<div{{ attributes.addClass(classes) }}>
  {{- title_prefix -}}
  {{- title_suffix -}}

  {%- include "mud_egov:button" with {
    label: current_language_label,
    variant: 'secondary',
    shape: 'circular',
    icon_position: 'left',
    button_att: block_btn_att,
  } -%}

  {%- include "mud_egov:popover" with {
    popover_id: block_id,
    popover_menu_items: language_menu_items,
    popover_uc: ['mobile-language-list'],
  } -%}
</div>
