{#
/**
 * @file
 * mud_egov's override for the main menu navigation block.
 */
#}
{%
  set classes = [
  'block',
  'block-menu',
  'menu--' ~ derivative_plugin_id|clean_class,
]
%}

{% set heading_id = attributes.id ~ '-menu'|clean_id %}

{% include "mud_egov:block" with {
  block_tag: 'nav',
  block_label_visible: configuration.label_display is same as('visible'),
  block_label_tag: 'h3',
  block_label: configuration.label,
  block_content: content,
  block_uc: classes,
  block_att: attributes.setAttribute('aria-labelledby', heading_id).setAttribute('role', 'navigation'),
  block_label_att: title_attributes.setAttribute('id', heading_id),
} %}
