{#
/**
 * @file
 * mud_egov override for the file_link theme hook.
 *
 * Delegates to the mud_egov:file-link component. Extra variables prepared by
 * mud_egov_preprocess_file_link():
 * - file_link_url: Direct URL to the file.
 * - file_link_title: Human-readable title (filename without extension,
 *   underscores replaced by spaces, first letter capitalized).
 * - file_link_extension: Lowercase extension (no dot).
 * - file_link_date: Pre-formatted publication date from the parent Media entity
 *   (field_publication_date), when available.
 *
 * Core variables used:
 * - file_size: Formatted size (e.g. "1.3 MB").
 * - attributes: HTML attributes for the anchor wrapper.
 */
#}
{% include 'mud_egov:file-link' with {
  file_link_url: file_link_url,
  file_link_title: file_link_title,
  file_link_extension: file_link_extension,
  file_link_size: file_size,
  file_link_date: file_link_date|default(null),
  file_link_att: attributes,
} only %}
