{#
/**
 * @file
 * mud_egov theme implementation for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 * - is_primary: TRUE if button has button-primary class.
 * - is_secondary: TRUE if button has button-secondary class.
 * - button_color: The button color ('primary', 'secondary').
 *
 * @see template_preprocess_input()
 *
 * @ingroup themeable
 */
#}

{% set btnColor %}
  {%- if attributes.hasClass('button--primary') -%}
    primary
  {%- elseif attributes.hasClass('button--secondary') -%}
    secondary
  {%- else -%}
    primary
  {%- endif -%}
{% endset %}

{% include "mud_egov:button" with {
  button_label: attributes.value,
  button_tag: 'input',
  button_variant: btnColor|trim,
  button_att: attributes,
} %}
