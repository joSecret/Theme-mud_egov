{#
/**
 * @file
 * mud_egov override for status messages.
 *
 * Renders Drupal messenger messages through the `notification` SDC
 * component using the subtle emphasis (inline tint surface).
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 * - status_headings: List of all status types (accessible severity labels).
 * - display: (optional) May have a value of 'status' or 'error' when only
 *   displaying messages of that specific type.
 * - attributes: HTML attributes for the element, including:
 *   - class: HTML classes.
 */
#}

{% set drupal_type_map = {
  'status':  'success',
  'warning': 'warning',
  'error':   'error',
} %}

{% for type, messages in message_list %}
  {% include "mud_egov:notification" with {
    notification_variant: drupal_type_map[type],
    notification_sr_heading: status_headings[type],
    notification_message: messages,
    notification_dismissible: true,
  } only %}
{% endfor %}
